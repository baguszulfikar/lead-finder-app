# Sumber data. Kosongkan semua key untuk memakai data contoh (mock).
# "google" | "outscraper" | "mock"
LEAD_SOURCE_DEFAULT=mock

# Google Places API (New): https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Outscraper (scraping provider, akun terpisah dari Google Cloud): https://app.outscraper.com/profile
OUTSCRAPER_API_KEY=

# Supabase (opsional di tahap ini; dipakai untuk menyimpan hasil pencarian)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
